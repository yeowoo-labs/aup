# Each input fails on some presses; a failed event changes nothing.
state q = 1
state r = 0
state s = 5
input divide = KeyD
input grow = KeyG
input bound = KeyB
text shown(0, 0, r, "r")
on divide.down {
  r = r + 1
  q = 10 / (q - 1)
}
on grow.down {
  s = s * 1e200
}
on bound.down {
  r = r + 1
  s = clamp(s, r, 3)
}
